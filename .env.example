# Optional runtime configuration for the Portfolio Risk Engine.
# Copy this file to `.env` and adjust values. Streamlit Community Cloud
# users can instead set the same keys in the app's Secrets panel.

# Seconds allowed for each Yahoo Finance download.
YFINANCE_TIMEOUT=30

# Display currency used when the sidebar is first loaded: USD or INR.
DEFAULT_CURRENCY=INR

# Annual risk-free rate used in the Sharpe ratio (decimal, 0.02 = 2.0%).
RISK_FREE_RATE=0.02
